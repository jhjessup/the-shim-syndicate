#!/usr/bin/env bash
# =============================================================================
# commit-msg — The Gavel's Audit Trace Enforcement Hook
# =============================================================================
# Version: 2.2.0
# Repository: jhjessup/the-shim-syndicate
#
# DESCRIPTION:
#   Git commit-msg hook that enforces the Syndicate-Audit-Trace trailer
#   requirement on all mission/ branch commits. This trailer provides an
#   immutable chain of custody linking every commit to a Gavel audit record.
#
# ACCEPTED TRAILER FORMATS:
#   Legacy (2-field, self-attested — transitional):
#     Syndicate-Audit-Trace: @gavel <STATUS> — <ISO-8601-timestamp>
#   Evidence-bound (3-field, verifiable — generate with scripts/audit-trace.sh):
#     Syndicate-Audit-Trace: @gavel <STATUS> — <ISO-8601-timestamp> — <12-hex-hash>
#
#   Examples:
#     Syndicate-Audit-Trace: @gavel PASS — 2026-04-03T14:22:00Z
#     Syndicate-Audit-Trace: @gavel CONDITIONAL PASS — 2026-04-03T14:22:00Z — a1b2c3d4e5f6
#
# TRANSITIONAL HASH POLICY:
#   - Trailer with NO hash  → accepted with a warning by DEFAULT (existing
#     hydrated projects must not break). Generate an evidence-bound trailer:
#       scripts/audit-trace.sh generate --status PASS --log <AUDIT_LOG.md>
#   - STRICT MODE (opt-in)  → export SYNDICATE_REQUIRE_TRACE_HASH=1 (or "true")
#     — per-repo via direnv/.env, or in CI — makes hashless trailers a HARD
#     FAILURE. This is the migration path toward the eventual flag day when
#     evidence-bound trailers become mandatory everywhere. Hashed trailers
#     are unaffected by this variable.
#   - Trailer WITH a hash   → the hash MUST match an `AUDIT_TRACE_HASH: <hash>`
#     entry in the branch audit log (anti-forgery check). Logs are searched
#     in order:
#       .syndicate/vault/<branch-sanitized>/logs/AUDIT_LOG.md
#       .syndicate/vault/<branch-sanitized>/AUDIT_LOG.md
#       .syndicate/logs/AUDIT_LOG.md
#     A hashed trailer with no matching entry FAILS the commit.
#
# INSTALLATION:
#   cp hooks/commit-msg /path/to/project/.git/hooks/commit-msg
#   chmod +x /path/to/project/.git/hooks/commit-msg
#
#   syndicate-init.sh --mission installs this automatically.
#
# BYPASS (emergency only — requires operator acknowledgment):
#   git commit --no-verify   # This bypasses ALL hooks. Logged as violation.
# =============================================================================
set -uo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG="$(cat "$COMMIT_MSG_FILE")"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "UNKNOWN")"

# Only enforce on mission/ branches
if [[ "$CURRENT_BRANCH" != mission/* ]]; then
  exit 0
fi

echo ""
echo -e "${CYAN}[GAVEL]${RESET} Checking commit message for Syndicate-Audit-Trace..."

TRAILER_PATTERN='^Syndicate-Audit-Trace:[[:space:]]*@gavel[[:space:]]+(PASS|CONDITIONAL PASS)[[:space:]]+—[[:space:]]+[0-9]{4}-[0-9]{2}-[0-9]{2}'

if echo "$COMMIT_MSG" | grep -qE "$TRAILER_PATTERN"; then
  TRACE_LINE="$(echo "$COMMIT_MSG" | grep -E "$TRAILER_PATTERN" | tail -1)"
  echo -e "${GREEN}[PASS]${RESET}  Syndicate-Audit-Trace found: $TRACE_LINE"

  # ---------------------------------------------------------------------------
  # Transitional evidence-binding check (v2.1.0):
  #   hash present  → must match an AUDIT_TRACE_HASH entry in the audit log
  #   hash absent   → warn, accept (legacy trailers remain valid for now)
  # ---------------------------------------------------------------------------
  TRACE_HASH="$(echo "$TRACE_LINE" | grep -oE '—[[:space:]][0-9a-f]{12}[[:space:]]*$' | grep -oE '[0-9a-f]{12}' || true)"

  if [[ -z "$TRACE_HASH" ]]; then
    if [[ "${SYNDICATE_REQUIRE_TRACE_HASH:-}" == "1" || "${SYNDICATE_REQUIRE_TRACE_HASH:-}" == "true" ]]; then
      echo ""
      echo -e "${RED}${BOLD}[FAIL] COMMIT BLOCKED — Hashless trailer rejected (strict mode)${RESET}"
      echo ""
      echo -e "  ${CYAN}SYNDICATE_REQUIRE_TRACE_HASH${RESET} is enabled in this environment, so the"
      echo -e "  Syndicate-Audit-Trace trailer MUST be evidence-bound (3-field, with a"
      echo -e "  12-hex audit hash matching an AUDIT_TRACE_HASH entry in the audit log)."
      echo ""
      echo -e "  Generate an evidence-bound trailer with:"
      echo -e "  ${CYAN}scripts/audit-trace.sh generate --status PASS --log <AUDIT_LOG.md>${RESET}"
      echo ""
      echo -e "  To temporarily restore the transitional warn-and-accept behavior,"
      echo -e "  unset SYNDICATE_REQUIRE_TRACE_HASH."
      echo ""
      exit 1
    fi
    echo -e "${YELLOW}[WARN]${RESET}  Trailer is not evidence-bound (no audit hash)."
    echo -e "        Generate one with: ${CYAN}scripts/audit-trace.sh generate --status PASS --log <AUDIT_LOG.md>${RESET}"
    echo -e "        (transitional: accepted for now — set SYNDICATE_REQUIRE_TRACE_HASH=1 to enforce)"
    exit 0
  fi

  SANITIZED_BRANCH="${CURRENT_BRANCH//\//-}"
  AUDIT_LOG_CANDIDATES=(
    ".syndicate/vault/${SANITIZED_BRANCH}/logs/AUDIT_LOG.md"
    ".syndicate/vault/${SANITIZED_BRANCH}/AUDIT_LOG.md"
    ".syndicate/logs/AUDIT_LOG.md"
  )

  AUDIT_LOG=""
  for candidate in "${AUDIT_LOG_CANDIDATES[@]}"; do
    if [[ -f "$candidate" ]]; then
      AUDIT_LOG="$candidate"
      break
    fi
  done

  if [[ -n "$AUDIT_LOG" ]] && grep -qE "^AUDIT_TRACE_HASH:[[:space:]]*${TRACE_HASH}[[:space:]]*$" "$AUDIT_LOG"; then
    echo -e "${GREEN}[PASS]${RESET}  Audit hash ${TRACE_HASH} is evidence-bound (matched in ${AUDIT_LOG})."
    exit 0
  fi

  echo ""
  echo -e "${RED}${BOLD}[FAIL] COMMIT BLOCKED — Audit hash not evidence-bound${RESET}"
  echo ""
  echo -e "  The trailer carries audit hash ${BOLD}${TRACE_HASH}${RESET}, but no matching"
  echo -e "  ${CYAN}AUDIT_TRACE_HASH: ${TRACE_HASH}${RESET} entry exists in the audit log."
  echo -e "  This is the anti-forgery check: a hashed trailer must correspond to a"
  echo -e "  written audit record appended by ${CYAN}scripts/audit-trace.sh generate${RESET}."
  echo ""
  echo -e "  Audit log paths searched:"
  for candidate in "${AUDIT_LOG_CANDIDATES[@]}"; do
    if [[ -f "$candidate" ]]; then
      echo -e "    - $candidate (exists — no matching entry)"
    else
      echo -e "    - $candidate (not found)"
    fi
  done
  echo ""
  echo -e "  Either regenerate the trailer with ${CYAN}scripts/audit-trace.sh generate${RESET},"
  echo -e "  or drop the hash to fall back to the legacy (warned) trailer format."
  echo ""
  exit 1
else
  echo ""
  echo -e "${RED}${BOLD}[FAIL] COMMIT BLOCKED — Missing Syndicate-Audit-Trace${RESET}"
  echo ""
  echo -e "  Every commit on a mission/ branch requires the Gavel audit trailer."
  echo -e "  Add the following line to the end of your commit message:"
  echo ""
  echo -e "  ${CYAN}Syndicate-Audit-Trace: @gavel PASS — $(date -u +%Y-%m-%dT%H:%M:%SZ)${RESET}"
  echo ""
  echo -e "  If The Gavel issued a CONDITIONAL PASS, use:"
  echo -e "  ${CYAN}Syndicate-Audit-Trace: @gavel CONDITIONAL PASS — $(date -u +%Y-%m-%dT%H:%M:%SZ)${RESET}"
  echo ""
  echo -e "  A FAIL trace is never a valid commit state — resolve findings first."
  echo ""
  exit 1
fi
