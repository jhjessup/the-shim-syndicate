#!/usr/bin/env bash
# =============================================================================
# pre-commit — The Gavel's Branch Integrity Hook
# =============================================================================
# Version: 2.5.0
# Repository: jhjessup/the-shim-syndicate
#
# DESCRIPTION:
#   Git pre-commit hook enforced by The Gavel. Runs automatically before every
#   `git commit` in any repository where this hook is installed. Performs the
#   following checks in strict order — any FAIL is a hard block:
#
#   [CHECK-1] BRANCH GUARD    — Refuses commits directly to 'main' or 'master'.
#                               Also invoked (via hooks/pre-merge-commit, with
#                               SYNDICATE_MERGE_CONTEXT=1) for merge commits
#                               landing on main/master — the sanctioned path
#                               per MISSION_BRIEF.md merge criteria — where it
#                               verifies the incoming branch is a mission/
#                               branch instead of blocking outright.
#   [CHECK-2] MISSION ORACLE  — On a mission/ branch, verifies the branch-local
#                               ORACLE.md exists and contains no unfilled
#                               {{placeholder}} tokens.
#   [CHECK-3] SECRETS SCAN    — Scans staged files for exposed credentials,
#                               API keys, and tokens. Delegates to gitleaks
#                               (`gitleaks protect --staged`) when installed;
#                               otherwise falls back to the built-in regex
#                               patterns (narrower coverage). Staged .env files
#                               are always blocked regardless of scanner.
#   [CHECK-4] ORACLE ANCHORS  — Verifies staged files do not introduce patterns
#                               explicitly prohibited in the mission ORACLE.md
#                               (reads PROHIBITED PATTERNS section if present).
#   [CHECK-5] TEST DOCTRINE   — Verifies .syndicate/TEST_DOCTRINE.md exists and
#                               contains no unfilled {{placeholder}} tokens.
#                               Missing file is a warning; unfilled tokens are a
#                               hard FAIL (same treatment as ORACLE.md).
#   [CHECK-6] SHIM SCHEMA     — When staged changes touch shims/*.json, runs
#                               scripts/validate-shims.sh (core repo only) and
#                               blocks the commit if any shim fails to validate
#                               against routing.schema.json.
#
# INSTALLATION:
#   # From the Syndicate core — install into a target project:
#   cp hooks/pre-commit /path/to/project/.git/hooks/pre-commit
#   chmod +x /path/to/project/.git/hooks/pre-commit
#
#   # Or use syndicate-init.sh --mission which installs automatically.
#
# NOTE ON Syndicate-Audit-Trace:
#   The commit message trailer check (Syndicate-Audit-Trace) is enforced by
#   the companion commit-msg hook. This hook focuses on code and context state.
#
# EXIT CODES:
#   0 — All checks passed. Commit proceeds.
#   1 — One or more checks failed. Commit is blocked.
# =============================================================================
set -uo pipefail

# -----------------------------------------------------------------------------
# Color output
# -----------------------------------------------------------------------------
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

PASS="${GREEN}[PASS]${RESET}"
FAIL="${RED}[FAIL]${RESET}"
WARN="${YELLOW}[WARN]${RESET}"
INFO="${CYAN}[INFO]${RESET}"

SYNDICATE_DIR=".syndicate"
FAIL_COUNT=0
WARN_COUNT=0
TOTAL_CHECKS=6

fail() { echo -e "${FAIL} $*" >&2; (( FAIL_COUNT++ )) || true; }
warn() { echo -e "${WARN} $*"; (( WARN_COUNT++ )) || true; }
pass() { echo -e "${PASS} $*"; }
info() { echo -e "${INFO} $*"; }

# -----------------------------------------------------------------------------
# Header
# -----------------------------------------------------------------------------
echo ""
echo -e "${BOLD}╔══════════════════════════════════════════════════════════════════╗${RESET}"
echo -e "${BOLD}║       THE GAVEL — Pre-Commit Audit (Branch-Based Mission)        ║${RESET}"
echo -e "${BOLD}╚══════════════════════════════════════════════════════════════════╝${RESET}"
echo ""

# -----------------------------------------------------------------------------
# Resolve context
# -----------------------------------------------------------------------------
CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "UNKNOWN")"
PROJECT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || echo ".")"
STUB_DIR="$PROJECT_DIR/$SYNDICATE_DIR"

info "Branch   : $CURRENT_BRANCH"
info "Project  : $PROJECT_DIR"

IS_MISSION=false
MISSION_VAULT=""
MISSION_ORACLE="$STUB_DIR/ORACLE.md"

if [[ "$CURRENT_BRANCH" == mission/* ]]; then
  IS_MISSION=true
  MISSION_VAULT="$STUB_DIR/vault/${CURRENT_BRANCH//\//-}"
  MISSION_ORACLE="$MISSION_VAULT/ORACLE.md"
  info "Mission  : ${CURRENT_BRANCH#mission/}"
  info "Vault    : $MISSION_VAULT"
fi

info "Oracle   : $MISSION_ORACLE"
echo ""

# -----------------------------------------------------------------------------
# CHECK-1: Branch Guard
# Refuse direct commits to main or master. A MERGE landing approved mission
# work onto main/master is the sanctioned path (see MISSION_BRIEF.md merge
# criteria: "merge must go through this branch") and is NOT a direct commit —
# hooks/pre-merge-commit sets SYNDICATE_MERGE_CONTEXT=1 before invoking this
# script for that case. In merge context, verify the incoming branch is a
# mission/ branch (preserving the spirit of the guard) instead of blocking.
# -----------------------------------------------------------------------------
echo -e "${BOLD}── CHECK-1: Branch Guard ──${RESET}"

# A pending .git/MERGE_HEAD unambiguously means this commit COMPLETES a merge
# that pre-merge-commit already gated (e.g. it blocked on a CHECK-2/5 failure,
# the operator fixed the issue, and is now retrying via plain `git commit` —
# the natural, expected next step, which git dispatches through pre-commit,
# NOT pre-merge-commit again). Without this, that retry is misidentified as a
# fresh direct commit to main/master and incorrectly blocked. Verified via a
# real blocked-merge-then-retry test scenario, not a hypothetical.
IS_MERGE_IN_PROGRESS=false
[[ -f "$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)" ]] && IS_MERGE_IN_PROGRESS=true

if [[ "$CURRENT_BRANCH" == "main" || "$CURRENT_BRANCH" == "master" ]]; then
  if [[ "${SYNDICATE_MERGE_CONTEXT:-0}" == "1" || "$IS_MERGE_IN_PROGRESS" == true ]]; then
    # Identifying the merge's source branch reliably is harder than it looks:
    # .git/MERGE_HEAD is NOT guaranteed to exist yet when pre-merge-commit
    # fires for a clean (non-conflicting) merge — confirmed empirically
    # (git 2.43, `ort` strategy) by inspecting .git/ at hook-fire time: only
    # AUTO_MERGE and ORIG_HEAD existed, no MERGE_HEAD. `git name-rev
    # --name-only MERGE_HEAD` therefore silently fails in exactly the common
    # case this check exists for. Try it anyway (works in some git
    # versions/scenarios, e.g. a merge that paused for conflicts and was
    # resumed), but the authoritative signal is the SYNDICATE_MERGE_SOURCE
    # env var the caller sets explicitly — the operator/agent running
    # `git merge <branch>` already knows the branch name; asking them to
    # pass it is far more robust than reverse-engineering git internals that
    # demonstrably vary by version and merge path.
    MERGE_SOURCE="${SYNDICATE_MERGE_SOURCE:-}"
    if [[ -z "$MERGE_SOURCE" ]]; then
      MERGE_SOURCE="$(git name-rev --name-only MERGE_HEAD 2>/dev/null || true)"
      MERGE_SOURCE="${MERGE_SOURCE#remotes/origin/}"
    fi
    if [[ -z "$MERGE_SOURCE" || "$MERGE_SOURCE" == "undefined" ]]; then
      warn "Could not determine the merge's source branch (MERGE_HEAD unavailable at hook time and SYNDICATE_MERGE_SOURCE was not set)."
      warn "Set SYNDICATE_MERGE_SOURCE=<branch> before 'git merge' to get a real mission-branch check here."
    elif [[ "$MERGE_SOURCE" == mission/* ]]; then
      pass "Merge into '${CURRENT_BRANCH}' originates from mission branch '${MERGE_SOURCE}'."
    else
      warn "Merge into '${CURRENT_BRANCH}' originates from '${MERGE_SOURCE}', not a mission/ branch — verify this is intentional."
    fi
  else
    fail "Direct commits to '${CURRENT_BRANCH}' are PROHIBITED by Branch Integrity policy."
    fail "The Lead must operate on a mission/ branch."
    fail "Create a mission branch:  git checkout -b mission/<name>"
    fail "Then re-run your commit."
    echo ""
    echo -e "${RED}${BOLD}COMMIT BLOCKED — Branch Integrity Violation${RESET}"
    echo ""
    exit 1
  fi
else
  pass "Branch '${CURRENT_BRANCH}' is not a protected branch."
fi

echo ""

# -----------------------------------------------------------------------------
# CHECK-2: Mission Oracle Integrity
# On mission/ branches: vault and ORACLE.md must exist; no unfilled placeholders.
# -----------------------------------------------------------------------------
echo -e "${BOLD}── CHECK-2: Mission Oracle Integrity ──${RESET}"

if [[ "$IS_MISSION" == true ]]; then

  # Vault directory must exist
  if [[ ! -d "$MISSION_VAULT" ]]; then
    fail "Mission vault not found: $MISSION_VAULT"
    fail "Run:  bash syndicate-init.sh --mission  to initialize this branch."
  else
    pass "Mission vault exists: $MISSION_VAULT"
  fi

  # ORACLE.md must exist
  if [[ ! -f "$MISSION_ORACLE" ]]; then
    fail "Mission ORACLE.md not found: $MISSION_ORACLE"
    fail "The Gavel cannot audit without a project oracle. Commit blocked."
  else
    pass "ORACLE.md found."

    # Check for unfilled placeholder tokens
    UNFILLED=$(grep -oE '\{\{[^}]+\}\}' "$MISSION_ORACLE" 2>/dev/null || true)
    if [[ -n "$UNFILLED" ]]; then
      fail "ORACLE.md contains unfilled placeholders — complete these before committing:"
      while IFS= read -r token; do
        fail "  → $token"
      done <<< "$UNFILLED"
    else
      pass "ORACLE.md is fully populated (no unfilled placeholders)."
    fi
  fi

else
  # Non-mission branch: still check the project-level oracle if it exists
  if [[ -f "$MISSION_ORACLE" ]]; then
    UNFILLED=$(grep -oE '\{\{[^}]+\}\}' "$MISSION_ORACLE" 2>/dev/null || true)
    if [[ -n "$UNFILLED" ]]; then
      warn "Project ORACLE.md contains unfilled placeholders. Consider completing it."
    else
      pass "Project ORACLE.md is present and populated."
    fi
  else
    warn "No project ORACLE.md found at $MISSION_ORACLE. Agents will operate without project context."
  fi
fi

echo ""

# -----------------------------------------------------------------------------
# CHECK-3: Secrets Scan
# Detect exposed credentials in staged files.
# -----------------------------------------------------------------------------
echo -e "${BOLD}── CHECK-3: Secrets Scan (Staged Files) ──${RESET}"

# Get list of staged files (added or modified)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

if [[ -z "$STAGED_FILES" ]]; then
  pass "No staged files to scan."
else
  SECRETS_FOUND=false
  STAGED_COUNT="$(echo "$STAGED_FILES" | wc -l | tr -d ' ')"

  # .env-file guard — ALWAYS runs, regardless of which scanner handles the
  # content scan. Committing a .env file is a hard failure in every mode.
  while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    if [[ "$file" == ".env" || "$file" == *".env."* ]]; then
      fail "Staged file is a .env file: $file — this must be gitignored, not committed."
      SECRETS_FOUND=true
    fi
  done <<< "$STAGED_FILES"

  # Delegation: prefer gitleaks when installed (broader, maintained ruleset).
  # Any problem RUNNING gitleaks → warn + regex fallback (graceful degradation).
  # gitleaks running and FINDING leaks → hard FAIL.
  USE_REGEX_FALLBACK=true
  if command -v gitleaks &>/dev/null; then
    GITLEAKS_OUTPUT="$(gitleaks protect --staged --no-banner --redact 2>&1)"
    GITLEAKS_EXIT=$?
    if [[ "$GITLEAKS_EXIT" -eq 0 ]]; then
      pass "gitleaks scan clean (${STAGED_COUNT} staged files)."
      USE_REGEX_FALLBACK=false
    elif [[ "$GITLEAKS_EXIT" -eq 126 || "$GITLEAKS_EXIT" -eq 127 ]] || \
         echo "$GITLEAKS_OUTPUT" | grep -qiE 'unknown (command|flag)|unknown shorthand flag|flag provided but not defined'; then
      warn "gitleaks is installed but could not run (exit ${GITLEAKS_EXIT}) — falling back to built-in regex scan."
    else
      fail "gitleaks detected potential secrets in the staged diff (output redacted):"
      while IFS= read -r gl_line; do
        echo -e "        ${gl_line}" >&2
      done <<< "$GITLEAKS_OUTPUT"
      fail "  Move these values to .env and reference them via environment variables."
      SECRETS_FOUND=true
      USE_REGEX_FALLBACK=false
    fi
  else
    info "gitleaks not installed — using built-in regex fallback (narrower coverage)."
  fi

  if [[ "$USE_REGEX_FALLBACK" == true ]]; then
    # Patterns that indicate hardcoded secrets
    declare -a SECRET_PATTERNS=(
      'ANTHROPIC_API_KEY\s*=\s*["\x27]?sk-ant-'
      'GOOGLE_API_KEY\s*=\s*["\x27]?AIza'
      'AWS_SECRET_ACCESS_KEY\s*=\s*["\x27][A-Za-z0-9/+]{40}'
      'AWS_ACCESS_KEY_ID\s*=\s*["\x27]?AKIA[A-Z0-9]{16}'
      'GITHUB_TOKEN\s*=\s*["\x27]?gh[pousr]_[A-Za-z0-9]{36}'
      'PASSWORD\s*=\s*["\x27][^\$\{"\x27][^"\x27]{6,}'
      'SECRET\s*=\s*["\x27][^\$\{"\x27][^"\x27]{8,}'
      'PRIVATE_KEY\s*=\s*["\x27]'
      '-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----'
      'sk-[A-Za-z0-9]{20}[A-Za-z0-9_-]{10,}'
      'xox[baprs]-[A-Za-z0-9-]{10,}'
      '[Aa]uthorization["\x27]?\s*[:=]\s*["\x27]?Bearer\s+[A-Za-z0-9._~+/-]{20,}'
      '1//[A-Za-z0-9_-]{28,}'
      'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
    )

    while IFS= read -r file; do
      [[ -z "$file" ]] && continue
      # Skip binary files and known safe directories
      if git show ":$file" 2>/dev/null | file --mime - 2>/dev/null | grep -q 'binary'; then
        continue
      fi
      # .env files were already failed by the always-on guard above
      if [[ "$file" == ".env" || "$file" == *".env."* ]]; then
        continue
      fi

      for pattern in "${SECRET_PATTERNS[@]}"; do
        if git show ":$file" 2>/dev/null | grep -qiE -e "$pattern"; then
          fail "Possible secret detected in: $file"
          fail "  Pattern matched: $pattern"
          fail "  Move this value to .env and reference it via environment variable."
          SECRETS_FOUND=true
        fi
      done
    done <<< "$STAGED_FILES"

    if [[ "$SECRETS_FOUND" == false ]]; then
      pass "No secret patterns detected in ${STAGED_COUNT} staged file(s)."
    fi
  fi
fi

echo ""

# -----------------------------------------------------------------------------
# CHECK-4: ORACLE-Prohibited Pattern Guard
# If ORACLE.md has a PROHIBITED PATTERNS section, verify staged files do not
# introduce any explicitly banned code patterns.
# -----------------------------------------------------------------------------
echo -e "${BOLD}── CHECK-4: Oracle Prohibited Pattern Guard ──${RESET}"

if [[ -f "$MISSION_ORACLE" ]]; then
  # Extract prohibited patterns from ORACLE.md (lines under "### Prohibited Patterns")
  # Expects lines formatted as: `- PATTERN: <pattern>` — the full pattern after
  # the prefix is captured verbatim (internal spaces preserved, trailing trimmed).
  PROHIBITED=$(awk '/### Prohibited Patterns/{found=1; next} /^##/{found=0} found && /^- PATTERN:/{sub(/^- PATTERN:[[:space:]]*/, ""); sub(/[[:space:]]+$/, ""); print}' \
    "$MISSION_ORACLE" 2>/dev/null || true)

  if [[ -z "$PROHIBITED" ]]; then
    pass "No machine-readable prohibited patterns defined in ORACLE.md."
  else
    CHECK4_FAILS=0
    while IFS= read -r pattern; do
      [[ -z "$pattern" ]] && continue
      while IFS= read -r file; do
        [[ -z "$file" ]] && continue
        if git show ":$file" 2>/dev/null | grep -qE "$pattern"; then
          fail "ORACLE-prohibited pattern found in staged file: $file"
          fail "  Prohibited pattern: $pattern"
          (( CHECK4_FAILS++ )) || true
        fi
      done <<< "$STAGED_FILES"
    done <<< "$PROHIBITED"

    if [[ "$CHECK4_FAILS" -eq 0 ]]; then
      pass "All staged files are clean of Oracle-prohibited patterns."
    fi
  fi
else
  info "No ORACLE.md available for prohibited pattern check — skipping."
fi

echo ""

# -----------------------------------------------------------------------------
# CHECK-5: Test Doctrine Integrity
# Verify .syndicate/TEST_DOCTRINE.md exists and has no unfilled placeholders.
# Missing file → warning (project may not yet use the doctrine).
# Unfilled placeholders → hard FAIL (same policy as ORACLE.md).
# -----------------------------------------------------------------------------
echo -e "${BOLD}── CHECK-5: Test Doctrine Integrity ──${RESET}"

DOCTRINE_PATH="$STUB_DIR/TEST_DOCTRINE.md"

# On mission/ branches, also check for a vault-local TEST_DOCTRINE.md
if [[ "$IS_MISSION" == true && -f "$MISSION_VAULT/TEST_DOCTRINE.md" ]]; then
  DOCTRINE_PATH="$MISSION_VAULT/TEST_DOCTRINE.md"
fi

if [[ ! -f "$DOCTRINE_PATH" ]]; then
  warn "TEST_DOCTRINE.md not found at $DOCTRINE_PATH."
  warn "Test Doctrine is required for complete Gavel auditing."
  warn "Generate it:  bash syndicate-init.sh  (or copy from Syndicate Core template)"
else
  pass "TEST_DOCTRINE.md found: $DOCTRINE_PATH"

  # Check for unfilled placeholder tokens
  DOCTRINE_UNFILLED=$(grep -oE '\{\{[^}]+\}\}' "$DOCTRINE_PATH" 2>/dev/null || true)
  if [[ -n "$DOCTRINE_UNFILLED" ]]; then
    fail "TEST_DOCTRINE.md contains unfilled placeholders — complete these before committing:"
    while IFS= read -r token; do
      fail "  → $token"
    done <<< "$DOCTRINE_UNFILLED"
    fail "Refer to §2.2, §3.1, and §3.2 of the doctrine for guidance on what to fill in."
  else
    pass "TEST_DOCTRINE.md is fully populated (no unfilled placeholders)."
  fi
fi

echo ""

# -----------------------------------------------------------------------------
# CHECK-6: Shim Schema Validation
# Core-repo scoped: when staged changes touch shims/*.json, run the shim
# validator so an invalid shim or schema change can never land.
# -----------------------------------------------------------------------------
echo -e "${BOLD}── CHECK-6: Shim Schema Validation ──${RESET}"

if echo "$STAGED_FILES" | grep -qE '^shims/.*\.json$' && [[ -f "$PROJECT_DIR/scripts/validate-shims.sh" ]]; then
  if bash "$PROJECT_DIR/scripts/validate-shims.sh"; then
    pass "All shim configurations validate against routing.schema.json."
  else
    fail "Shim schema validation failed — staged shim/schema changes do not validate."
  fi
else
  info "No staged shim changes — skipping."
fi

echo ""

# -----------------------------------------------------------------------------
# Result
# -----------------------------------------------------------------------------
echo -e "${BOLD}── Gavel Pre-Commit Verdict ──${RESET}"

if [[ "$FAIL_COUNT" -gt 0 ]]; then
  echo ""
  echo -e "${RED}${BOLD}  COMMIT BLOCKED — $FAIL_COUNT check(s) FAILED${RESET}"
  echo ""
  echo -e "  ${BOLD}The Gavel does not pass work with unresolved Critical findings.${RESET}"
  echo -e "  Resolve all FAIL items above, then re-run git commit."
  echo -e "  Audit findings will be appended to: ${MISSION_ORACLE%ORACLE.md}logs/AUDIT_LOG.md"
  echo ""
  exit 1
else
  echo ""
  echo -e "${GREEN}${BOLD}  COMMIT CLEARED — All ${TOTAL_CHECKS} checks passed${RESET}"
  [[ "$WARN_COUNT" -gt 0 ]] && \
    echo -e "  ${YELLOW}${WARN_COUNT} warning(s) noted — review recommended but not blocking.${RESET}"
  echo ""
  echo -e "  ${BOLD}Reminder:${RESET} Your commit message must include:"
  echo -e "  ${CYAN}Syndicate-Audit-Trace: @gavel PASS — $(date -u +%Y-%m-%dT%H:%M:%SZ)${RESET}"
  echo ""
  exit 0
fi
